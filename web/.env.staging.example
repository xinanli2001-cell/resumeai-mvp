NODE_ENV="production"
APP_ENV="staging"
# Start closed-beta staging in invite_only; the seeded admin creates the first code while registration stays closed.
# Switch to open only when public registration is intentionally enabled.
REGISTRATION_MODE="invite_only"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"
SESSION_SECRET="<generate with openssl rand -base64 48>"
LLM_PROVIDER="openai"
OPENAI_API_KEY="<set in Render dashboard>"
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-5.6"
DEEPSEEK_API_KEY="<set only when LLM_PROVIDER=deepseek>"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"
LLM_RATE_LIMIT_PER_MINUTE="10"
MAX_TEXT_BYTES="20000"
MAX_RESUME_FILE_BYTES="15728640"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="<set in Render dashboard>"

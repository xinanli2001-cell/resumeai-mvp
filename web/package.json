{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "pnpm db:generate && vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm db:generate && playwright test",
    "db:generate": "prisma generate",
    "db:generate:prod": "tsx scripts/create-postgres-schema.ts && prisma generate --schema prisma/generated/schema.postgres.prisma",
    "db:migrate": "tsx scripts/sqlite-migrate.ts",
    "db:migrate:prod": "tsx scripts/create-postgres-schema.ts && prisma migrate deploy --schema prisma/generated/schema.postgres.prisma",
    "db:push:prod": "tsx scripts/create-postgres-schema.ts && prisma db push --accept-data-loss --schema prisma/generated/schema.postgres.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:backup": "tsx scripts/backup.ts",
    "smoke:staging": "tsx scripts/smoke-staging.ts",
    "validate:render": "tsx scripts/validate-render-blueprint.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.3",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.22.5",
    "typescript": "^5",
    "vitest": "^4.1.9",
    "yaml": "^2.9.0"
  }
}
